{
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest",
    "check": "biome check --write . --unsafe",
    "play": "bun --filter='playground' run dev",
    "build": "bun --filter unplugin-caddy build",
    "typecheck": "tsc --project tsconfig.json --noEmit && bun --filter='*' typecheck",
    "changeset:version": "changeset version && biome format . --write",
    "changeset:publish": "bun ./scripts/publish.ts --registry='https://registry.npmjs.org'",
    "*": "bun run build && bun run check && bun typecheck && bun --filter unplugin-caddy check:repo"
  },
  "imports": {
    "#unplugin-caddy/*": "./packages/unplugin-caddy/*"
  },
  "workspaces": {
    "packages": [
      "example",
      "packages/*"
    ],
    "catalog": {
      "vite": "^7.1.7",
      "esbuild": "^0.25.10",
      "typescript": "^5.9.2",
      "@types/bun": "^1.2.22",
      "@types/node": "^24.5.2",
      "@total-typescript/ts-reset": "^0.6.1"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.29.7",
    "@total-typescript/ts-reset": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "execa": "^9.6.0",
    "picocolors": "^1.1.1",
    "typescript": "catalog:",
    "unplugin": "^2.3.10",
    "vite": "catalog:",
    "vitest": "^3.2.4"
  },
  "readme": "./.github/README.md",
  "license": "MIT",
  "packageManager": "bun@1.2.22"
}
