{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "allowJs": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "types": [
      "bun",
      "node"
    ],
    "paths": {
      "#unplugin-caddy/rspack": [
        "../unplugin-caddy/src/rspack.ts"
      ],
      "#unplugin-caddy/*": [
        "../unplugin-caddy/src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.js",
    "**/*.mjs"
  ]
}
