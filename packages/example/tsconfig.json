{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "allowJs": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "types": [
      "bun",
      "node"
    ],
    "paths": {
      // "../unplugin-caddy/*": [
      //   "../../src/*"
      // ]
    }
  },
  "include": [
    "**/*.ts",
    "esbuild.config.js"
  ],
  "files": [
    "vite-env.d.ts",
    "esbuild.config.js",
    "reset.d.ts",
    "vite.config.ts",
    "main.ts"
  ]
}
