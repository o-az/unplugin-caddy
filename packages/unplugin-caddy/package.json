{
  "name": "unplugin-caddy",
  "version": "0.0.5",
  "type": "module",
  "description": "Caddy plugin for Vite, Astro, esbuild, Rollup, Rolldown, Webpack, Rspack, Astro, and Farm",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./astro": "./dist/astro.js",
    "./esbuild": "./dist/esbuild.js",
    "./farm": "./dist/farm.js",
    "./rollup": "./dist/rollup.js",
    "./rolldown": "./dist/rolldown.js",
    "./rspack": "./dist/rspack.js",
    "./vite": "./dist/vite.js",
    "./webpack": "./dist/webpack.js",
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*",
        "./*"
      ]
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "readme": "https://github.com/o-az/unplugin-caddy/blob/main/.github/README.md",
  "scripts": {
    "build": "tsdown --config='tsdown.config.ts'",
    "test": "vitest",
    "start": "bun src/index.ts",
    "check": "biome check --write . --unsafe",
    "dev": "tsdown --config='tsdown.config.ts' --watch",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "publint": "bun x publint@latest run --pack bun",
    "check:repo": "bun run publint && bun run attw",
    "attw": "bun x @arethetypeswrong/cli@latest --pack . --ignore-rules='false-cjs' --ignore-rules='cjs-resolves-to-esm'",
    "*": "bun run build && bun run check && bun run check:types && bun run check:repo"
  },
  "dependencies": {
    "picocolors": "^1.1.1",
    "unplugin": "^2.3.10",
    "unplugin-utils": "^0.3.0"
  },
  "devDependencies": {
    "@rspack/core": "^1.5.7",
    "@total-typescript/ts-reset": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "publint": "^0.3.13",
    "rollup": "^4.52.3",
    "tsdown": "^0.15.6",
    "typescript": "catalog:",
    "unplugin-unused": "^0.5.3",
    "vite": "catalog:",
    "webpack-dev-server": "^5.2.2"
  },
  "peerDependencies": {
    "vite": ">=3",
    "esbuild": "catalog:",
    "rollup": "^3",
    "@farmfe/core": ">=1",
    "webpack": "^5",
    "@rspack/core": ">=1"
  },
  "peerDependenciesMeta": {
    "@farmfe/core": {
      "optional": true
    },
    "esbuild": {
      "optional": true
    },
    "rollup": {
      "optional": true
    },
    "rolldown": {
      "optional": true
    },
    "@rspack/core": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "webpack": {
      "optional": true
    }
  },
  "imports": {
    "#*": "./src/*",
    "#package.json": "./package.json"
  },
  "license": "MIT",
  "homepage": "https://github.com/o-az/unplugin-caddy",
  "author": "Omar <omaraziz.dev@gmail.com> (https://github.com/o-az)",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "caddy",
    "https",
    "localhost",
    "unplugin",
    "vite",
    "rollup",
    "rolldown",
    "webpack",
    "tunnel"
  ],
  "repository": {
    "type": "git",
    "directory": "packages/unplugin-caddy",
    "url": "git+https://github.com/o-az/unplugin-caddy.git"
  }
}
